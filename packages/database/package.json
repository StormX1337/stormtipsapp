{
  "name": "@storm-tips/database",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "prisma generate",
    "migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "migrate:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "migrate:status": "dotenv -e ../../.env -- prisma migrate status",
    "push": "dotenv -e ../../.env -- prisma db push",
    "reset": "dotenv -e ../../.env -- prisma migrate reset --force",
    "seed": "dotenv -e ../../.env -- tsx prisma/seed.ts",
    "set-password": "dotenv -e ../../.env -- tsx prisma/set-password.ts",
    "merge-leagues": "dotenv -e ../../.env -- tsx prisma/merge-leagues.ts",
    "stripe-sync-prices": "dotenv -e ../../.env -- tsx prisma/stripe-sync-prices.ts",
    "studio": "dotenv -e ../../.env -- prisma studio",
    "validate": "dotenv -e ../../.env -- prisma validate",
    "build": "prisma generate",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "health": "dotenv -e ../../.env -- tsx prisma/health.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.16.2",
    "prisma": "6.16.2"
  },
  "devDependencies": {
    "@storm-tips/auth": "workspace:*",
    "@storm-tips/config": "workspace:*",
    "@storm-tips/payments": "workspace:*",
    "@storm-tips/sports": "workspace:*",
    "@storm-tips/statistics": "workspace:*",
    "@storm-tips/types": "workspace:*",
    "dotenv-cli": "^10.0.0",
    "ioredis": "^5.11.1",
    "stripe": "^19.3.1",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3"
  }
}
