{
  "name": "storm-tips",
  "version": "1.0.0",
  "private": true,
  "description": "STORM TIPS \u2014 premium sports analytics & betting tips platform (API, web, admin, mobile).",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "pnpm run --parallel --filter \"./apps/api\" --filter \"./apps/worker\" --filter \"./apps/web\" --filter \"./apps/admin\" dev",
    "dev:api": "pnpm --filter @storm-tips/api dev",
    "dev:worker": "pnpm --filter @storm-tips/worker dev",
    "dev:web": "pnpm --filter @storm-tips/web dev",
    "dev:admin": "pnpm --filter @storm-tips/admin dev",
    "dev:mobile": "pnpm --filter @storm-tips/mobile start",
    "build": "pnpm --filter @storm-tips/database build && pnpm -r --filter \"./apps/*\" build",
    "build:api": "pnpm --filter @storm-tips/api build",
    "build:web": "pnpm --filter @storm-tips/web build",
    "build:admin": "pnpm --filter @storm-tips/admin build",
    "start:api": "pnpm --filter @storm-tips/api start",
    "start:worker": "pnpm --filter @storm-tips/worker start",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:generate": "pnpm --filter @storm-tips/database generate",
    "db:migrate": "pnpm --filter @storm-tips/database migrate",
    "db:migrate:deploy": "pnpm --filter @storm-tips/database migrate:deploy",
    "db:push": "pnpm --filter @storm-tips/database push",
    "db:seed": "pnpm --filter @storm-tips/database seed",
    "db:studio": "pnpm --filter @storm-tips/database studio",
    "db:reset": "pnpm --filter @storm-tips/database reset",
    "docker:up": "docker compose -f infra/docker/docker-compose.yml up -d",
    "docker:down": "docker compose -f infra/docker/docker-compose.yml down",
    "docker:build": "docker compose -f infra/docker/docker-compose.yml build",
    "prepare": "node -e \"process.exit(0)\""
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.18.13",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "overrides": {
      "react": "19.1.0",
      "react-dom": "19.1.0",
      "@types/react": "19.1.17",
      "@types/react-dom": "19.1.11"
    }
  }
}
