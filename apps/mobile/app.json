{
  "expo": {
    "name": "PROFIT TIPS",
    "slug": "profit-tips",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "profittips",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "backgroundColor": "#0A0C10",
    "primaryColor": "#12E17F",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.profittips.app",
      "config": { "usesNonExemptEncryption": false },
      "infoPlist": {
        "UIBackgroundModes": ["remote-notification"],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.profittips.app",
      "adaptiveIcon": { "backgroundColor": "#0A0C10" },
      "permissions": ["POST_NOTIFICATIONS"],
      "edgeToEdgeEnabled": true
    },
    "web": { "bundler": "metro", "output": "single" },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-localization",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A0C10",
          "imageWidth": 180,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#12E17F",
          "defaultChannel": "tips"
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": { "deploymentTarget": "15.1" },
          "android": { "compileSdkVersion": 35, "targetSdkVersion": 35, "minSdkVersion": 24 }
        }
      ]
    ],
    "experiments": { "typedRoutes": true },
    "extra": {
      "eas": { "projectId": "00000000-0000-0000-0000-000000000000" }
    }
  }
}
