[Unit]
Description=STORM TIPS background worker
Documentation=https://github.com/StormX1337/stormtipsapp/blob/main/docs/deployment.md
# Everything the worker needs is in containers or on the data volume, so it must
# not start before either is there. Without the mount it would run against an
# empty Docker root and quietly do nothing.
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service
RequiresMountsFor=/mnt/HC_Volume_106874042
# A crash loop should surface as a failed unit rather than hide behind endless
# restarts: five failures within a minute stops it for good. These belong in
# [Unit]; systemd ignores them under [Service].
StartLimitBurst=5
StartLimitIntervalSec=60

[Service]
Type=simple
User=root
WorkingDirectory=/root/stormtipsapp/apps/worker
EnvironmentFile=/root/stormtipsapp/.env
# The compiled entry point, not a package manager: one process to supervise,
# and no shell in between to swallow the exit code.
ExecStart=/usr/bin/env node dist/index.js

# The worker handles SIGTERM itself — it drops its heartbeat, closes the queues
# and disconnects cleanly, which is what keeps the admin banner honest.
KillSignal=SIGTERM
TimeoutStopSec=30

Restart=always
RestartSec=5

StandardOutput=journal
StandardError=journal
SyslogIdentifier=storm-tips-worker

[Install]
WantedBy=multi-user.target
